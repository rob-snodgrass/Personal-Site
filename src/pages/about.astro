---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Rob Snodgrass" description="About Rob Snodgrass Lorem Ipsum">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/20230130_174046.jpg"
					alt="Rob Snodgrass at work with a colleague"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I am a Columbus, Ohio-based full-stack software engineer specializing in public sector enterprise applications, scalable Java services, and modern web architectures. 
						With a foundation in economics, global supply chain operations, and enterprise modernization, my early career was defined by managing complex procurement, cross-border logistics, 
						and international manufacturer relations. In that environment, operational precision, analytical rigor, and predictive planning were paramount.
					</p>
					<br>
					<p>
						Driven by a desire to build software systems that solve complex operational bottlenecks, I transitioned into full-stack engineering. 
						Today, my work centers on modernizing legacy enterprise systems by bridging the gap between complex database architectures and modern web applications. 
						I focus on designing robust relational schemas, engineering automated Spring Batch pipelines to process massive datasets reliably, 
						and building modular Angular frontends, turning dense backend operations into clean, performant end-to-end systems.
					</p>
					<br>
					<p>
						By combining this operational background with modern enterprise tools like RESTful APIs, containerization, and automated workflows, 
						I align technical architecture directly with business efficiency to deliver high-throughput software built for scale.
					</p>
					<br>
					<p>
						When I’m not writing code, I'm usually building custom PCs, gaming, exploring dark-sky astrophotography, following football, or tracking miles on the trail.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<div class="skills-grid">
						<div class="skill-category">
							<h5>Backend & Processing</h5>
							<p>Java, Spring Boot, Spring Batch, RESTful APIs</p>
						</div>
						<div class="skill-category">
							<h5>Frontend</h5>
							<p>Angular, Vue.js, TypeScript, JavaScript, HTML5, CSS</p>
						</div>
						<div class="skill-category">
							<h5>Database & Architecture</h5>
							<p>Relational Database Design, MSSQL, Schema Optimization, PostgreSQL/Oracle</p>
						</div>
						<div class="skill-category">
							<h5>DevOps & Tools</h5>
							<p>Docker, Kubernetes, Git, CI/CD Pipelines, Maven, Linux</p>
						</div>
					</div>
				</div>
			</section>
				<section>
					<h2 class="section-title">Education</h2>
					<div class="content">
						<p>Bachelor of Science in Economics, The Ohio State University</p>
						<p>2011-2015</p>
						<br>
						<p>Tech Elevator, Full-Stack Web Development Bootcamp</p>
						<p>2022</p>
					</div>
				</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
